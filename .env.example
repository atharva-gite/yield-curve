# Copy this file to .env. Do not commit .env.

# U.S. Treasury yields from FRED (Federal Reserve Bank of St. Louis).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# The app still opens from the local cache when this is empty.
FRED_API_KEY=

# AI Report and the Analyst conversation. Groq is the provider the app calls.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b

# Spare keys. The app does not call these providers yet.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# GitHub Models: a GitHub personal access token with models access
# https://github.com/marketplace/models
GITHUB_TOKEN=
# Mistral: https://console.mistral.ai
MISTRAL_API_KEY=
